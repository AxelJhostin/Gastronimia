# Entorno de ejecución.
APP_ENV=development
APP_NAME=Gastronomía API
API_V1_PREFIX=/api/v1

# Orígenes permitidos para CORS. Debe ser una lista JSON válida.
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# URL del frontend que recibirá a la persona después de aceptar una invitación.
FRONTEND_URL=http://localhost:3000

# Valores de Supabase. La service role nunca se comparte ni se expone al frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
FRONTEND_URL=http://localhost:3000
# Solo para ejecutar backend/tests/integration/test_live_api.py de forma local.
# RUN_LIVE_TESTS=1
# TEST_API_BASE_URL=http://127.0.0.1:8000
# TEST_ADMIN_EMAIL=admin@example.com
# TEST_ADMIN_PASSWORD=change-me
