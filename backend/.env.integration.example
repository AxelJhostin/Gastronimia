# Copia este archivo a .env.integration. Nunca lo subas al repositorio.
# Debe apuntar a un proyecto Supabase de pruebas o a Supabase local, nunca a producción.

RUN_LIVE_TESTS=1
TEST_API_BASE_URL=http://127.0.0.1:8000
TEST_ADMIN_EMAIL=admin.integration@example.com
TEST_ADMIN_PASSWORD=cambia-esta-clave-local

# Solo para el recorrido que crea datos; la prueba rechaza cualquier host remoto.
RUN_LOCAL_WORKFLOW_TESTS=1
TEST_SUPABASE_SERVICE_ROLE_KEY=obten-la-clave-solo-del-supabase-local
